{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Three deployable environments, each its own Worker with its own secrets and
  // hostnames (README, "Environments"). Always deploy with
  // `scripts/deploy.mjs --env test|uat|production`; the top level alone is only
  // what `npm run preview` runs locally, and has no routes so a bare
  // `wrangler deploy` can't reach anything real.
  "name": "lanna-animal-care",
  // worker/index.mjs wraps OpenNext's generated .open-next/worker.js: edge
  // cache → the Pi through its tunnel (ORIGIN_HOST) → local render. Set
  // ORIGIN_HOST to the tunnel hostname once the Pi is live (docs/pi-hosting.md);
  // empty means "render here", which is how the Worker always behaved.
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NODE_ENV": "production"
  },
  "observability": {
    "enabled": true
  },
  // The running version's id, tag and upload time, for Settings → System
  // status (src/lib/status/health.ts). A binding, so each environment below
  // repeats it: wrangler doesn't inherit bindings into an env block.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "env": {
    // Staff testing and pre-production checks: the dev database and the dev
    // Google Drive, on the Workers runtime, built from main.
    "test": {
      "name": "lanna-animal-care-test",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "routes": [{ "pattern": "test.lannacare.org", "custom_domain": true }],
      // No RELEASE_MAIL binding and RELEASE_MAIL_ENV empty: the dev database
      // never sends release mail (worker/release-mail.mjs).
      // PUBLIC_SITE "locked": signed-out visitors get the sign-in landing page,
      // not the public website (src/lib/public-site.ts).
      // Status alerts (src/lib/status/alerts.ts) DO run here: the cron below,
      // their own STATUS_ALERT_MAIL binding (not RELEASE_MAIL, whose guard
      // stays as it was) and the dev database's admins as recipients. This is
      // where the alert path is proved before production relies on it.
      "vars": {
        "NODE_ENV": "production",
        "ORIGIN_HOST": "",
        "ORIGIN_TIMEOUT_MS": "20000",
        "RELEASE_MAIL_ENV": "",
        "PUBLIC_SITE": "locked",
        "STATUS_ALERT_SITE": "https://test.lannacare.org",
        "STATUS_ALERT_FROM": "alerts@lannacare.org"
      },
      "send_email": [{ "name": "STATUS_ALERT_MAIL" }],
      // Every 15 minutes: ALERT_INTERVAL_MINUTES in src/lib/status/alerts.ts.
      "triggers": { "crons": ["*/15 * * * *"] }
    },
    // The customer's acceptance testing: the UAT database and the current
    // Google Drive, on lannacare.org for good (docs/decisions.md). Plumbing
    // only until the cutover: no routes, because lannacare.org still belongs
    // to the production block below, and scripts/deploy.mjs refuses --env uat
    // until src/lib/app-env.ts knows UAT's project. The cutover adds the
    // lannacare.org and www routes here and takes them off production.
    "uat": {
      "name": "lanna-animal-care-uat",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "routes": [],
      "vars": {
        "NODE_ENV": "production",
        "ORIGIN_HOST": "",
        "ORIGIN_TIMEOUT_MS": "20000",
        "RELEASE_MAIL_ENV": "UAT",
        "RELEASE_MAIL_FROM": "releases@lannacare.org",
        // UAT is never the public website (src/lib/public-site.ts).
        "PUBLIC_SITE": "locked"
      },
      "send_email": [{ "name": "RELEASE_MAIL" }]
    },
    // The live site: the production database. Drive stays on the dev Google
    // account until the shelter's own account is available (docs/decisions.md).
    "production": {
      "name": "lanna-animal-care",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "routes": [
        { "pattern": "lannacare.org", "custom_domain": true },
        { "pattern": "www.lannacare.org", "custom_domain": true }
      ],
      // Release mail (worker/release-mail.mjs). lannacare.org is UAT for good
      // and this database becomes UAT at the cutover, so it already sends as
      // UAT. At the cutover the production block moves to
      // lannacareforanimals.org with RELEASE_MAIL_ENV "Production" and a
      // From on that domain, and the uat block above takes over these routes.
      // PUBLIC_SITE "locked" for the same reason: lannacare.org is UAT and not
      // for the public (src/lib/public-site.ts). THE CUTOVER MUST DROP IT
      // from this block when it moves to lannacareforanimals.org, or the live
      // site opens on a sign-in page.
      "vars": {
        "NODE_ENV": "production",
        "ORIGIN_HOST": "",
        "ORIGIN_TIMEOUT_MS": "20000",
        "RELEASE_MAIL_ENV": "UAT",
        "RELEASE_MAIL_FROM": "releases@lannacare.org",
        "PUBLIC_SITE": "locked",
        // Status alerts, as on test. The cutover moves this block to
        // lannacareforanimals.org: STATUS_ALERT_SITE moves with it, and the
        // uat block takes lannacare.org and a copy of these alert entries.
        "STATUS_ALERT_SITE": "https://lannacare.org",
        "STATUS_ALERT_FROM": "alerts@lannacare.org"
      },
      "send_email": [{ "name": "RELEASE_MAIL" }, { "name": "STATUS_ALERT_MAIL" }],
      "triggers": { "crons": ["*/15 * * * *"] }
    }
  }
}
