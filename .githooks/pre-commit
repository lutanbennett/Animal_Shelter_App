#!/bin/sh
# Refuse a commit that adds a misnumbered migration: a new file under
# supabase/migrations/ must be one past the highest on origin/main, and no
# number may be used twice. The rule lives in scripts/check-migration-numbers.mjs,
# which CI runs too, so the two cannot drift apart.
#
# This hook runs in every worktree on the machine (core.hooksPath is shared),
# so it fails open: no node, no script (an older branch), no origin/main, or a
# crash all let the commit through with a note. It never fetches; CI checks
# against a fresh main.
#
# A commit that adds no migration file stops at the `git diff` below, before
# node starts — node alone takes about a second on this machine, and every
# commit in every stream would pay it. The script repeats the same test, so
# this line only decides how fast the answer comes, never what it is.
check_migrations() {
  git diff --cached --quiet --no-renames --diff-filter=A -- supabase/migrations/ && return 0
  command -v node >/dev/null 2>&1 || return 0
  [ -f scripts/check-migration-numbers.mjs ] || return 0
  node scripts/check-migration-numbers.mjs --staged
  rc=$?
  # 3 is the script's refusal. Anything else non-zero is node failing before it
  # could give a verdict (a syntax error, a broken import), which must not wedge
  # the commit.
  [ "$rc" -eq 3 ] && return 1
  [ "$rc" -ne 0 ] && echo "pre-commit: migration numbering check crashed (exit $rc) — commit allowed; CI checks the PR." >&2
  return 0
}

# Same shape for the backlog: an open item filed below `## Completed` is invisible
# to every session, and on 2026-10-19 one reached main through the backlog branch
# (no PR, no CI) and reddened every open PR's lint. Fast path again: nothing
# touching docs/backlog.md stops here before node starts. Fails open the same way.
check_backlog() {
  git diff --cached --quiet -- docs/backlog.md && return 0
  command -v node >/dev/null 2>&1 || return 0
  [ -f scripts/check-backlog-sections.mjs ] || return 0
  node scripts/check-backlog-sections.mjs --staged
  rc=$?
  [ "$rc" -eq 3 ] && return 1
  [ "$rc" -ne 0 ] && echo "pre-commit: backlog section check crashed (exit $rc) — commit allowed; CI checks the PR." >&2
  return 0
}

# The backlog branch only ever touches docs/backlog.md (CLAUDE.md, "The backlog
# branch"). The daily `git merge backlog && git push` reaches main with no PR, no
# CI and no review, so any other file committed there rides along unchecked: a
# CLAUDE.md rule did on 2026-10-07 and a misfiled line on 2026-10-19. Pure git, no
# node, so it is fast and has little to crash; if the branch name or the diff
# cannot be read it lets the commit through.
check_backlog_branch() {
  [ "$(git symbolic-ref --short -q HEAD 2>/dev/null)" = "backlog" ] || return 0
  others=$(git diff --cached --name-only --no-renames 2>/dev/null | grep -v -x "docs/backlog.md")
  [ -z "$others" ] && return 0
  echo "pre-commit: refused. The backlog branch may only change docs/backlog.md, because it reaches main with no PR, no CI and no review. Staged:" >&2
  echo "$others" | sed 's/^/  /' >&2
  echo "Unstage them (git restore --staged <file>) and put that change on a claude/<feature> branch with a PR." >&2
  return 1
}

check_migrations || exit 1
check_backlog_branch || exit 1
check_backlog || exit 1
exit 0
