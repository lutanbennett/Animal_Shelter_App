{
  "name": "lanna-animal-care",
  "version": "0.23.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/check-migration-grants.mjs && node scripts/check-permission-catalogue.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-home-screens.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/acceptance-matrix.mjs --check && node scripts/check-backlog-sections.mjs && node scripts/check-next-og.mjs",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.build.json",
    "opennext:build": "node -r ./scripts/win-junction-symlinks.cjs node_modules/@opennextjs/cloudflare/dist/cli/index.js build",
    "preview": "npm run opennext:build && opennextjs-cloudflare preview",
    "deploy:test": "node scripts/deploy.mjs --env test",
    "deploy:uat": "node scripts/deploy.mjs --env uat",
    "deploy:prod": "node scripts/deploy.mjs --env production",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "age-encryption": "^0.3.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "googleapis": "^181.0.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.145.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
