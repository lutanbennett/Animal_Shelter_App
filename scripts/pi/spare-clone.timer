# Sundays 04:00 Bangkok time, an hour after the weekly backup (cron, 03:00), so the
# clone carries that week's encrypted dump. Persistent: a missed run (Pi was off) fires at boot.
[Unit]
Description=Weekly clone of the NVMe onto the spare USB boot drive

[Timer]
OnCalendar=Sun *-*-* 04:00:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
