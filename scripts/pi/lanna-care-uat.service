# systemd unit for the UAT instance on the Pi — installed by
# scripts/pi/setup-uat.sh as /etc/systemd/system/lanna-care-uat.service
# (WorkingDirectory and the user are rewritten to the real ones there).
#
# A copy of lanna-care-test.service with these differences that matter:
#   - WorkingDirectory is the UAT clone (~/Animal_Shelter_App_uat), never the
#     production or test one: each clone has its own .next and .env.production.local,
#     and a shared folder would let one build overwrite what another serves.
#   - port 3002 (cloudflared routes uat-pi.lannacare.org there).
#   - priority between the two: the customer tests on it, so it is not starved like
#     test (Nice=10, CPUWeight=50), but production still wins when the Pi is busy.
[Unit]
Description=Lanna Care for Animals — UAT instance (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SVC_USER__
Group=__SVC_USER__
UMask=0002
WorkingDirectory=__REPO__
Environment=NODE_ENV=production
Environment=PORT=3002
ExecStart=__REPO__/node_modules/.bin/next start --port 3002 --hostname 127.0.0.1
Restart=always
RestartSec=3
Nice=5
CPUWeight=75
MemoryMax=900M
TimeoutStopSec=15
# Own user (docs/decisions/2026-10-22-pi-app-own-user.md): it reads the build and its env file,
# writes only the two caches below, and cannot open the deploy user's backups or deploy secrets.
# The "+" runs as root and hands the build cache over after each deploy swaps in a fresh one.
ExecStartPre=+/bin/sh -c 'mkdir -p __REPO__/.next/cache && chown -R __SVC_USER__:__SVC_USER__ __REPO__/.next/cache && chmod -R g+rwX __REPO__/.next/cache'
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__REPO__/.next/cache __PHOTO_CACHE__

[Install]
WantedBy=multi-user.target
