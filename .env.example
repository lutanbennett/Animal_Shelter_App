# Supabase — from your Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only scripts/ read these. The personal access token drives the Management
# API (migrations, deploys); the database password is for scripts/backup.mjs
# (Project Settings > Database — reset it there if it was never written down).
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# Optional: the whole session-pooler connection string, password included
# (postgresql://user:password@host:5432/postgres). On the Pi this replaces the
# SUPABASE_ACCESS_TOKEN pooler lookup, so the token never has to be there.
SUPABASE_DB_URL=
# The administrator's age PUBLIC key (age1...), for scripts/backup.mjs, which
# refuses to run without it. Public only: the private key (AGE-SECRET-KEY-1...)
# stays in the password manager and must never be put in any env file.
BACKUP_AGE_RECIPIENT=

# Google Drive — OAuth2 against the shelter's Google account (personal Gmail,
# not Workspace, so no domain-wide delegation). See src/lib/google/drive.ts
# and docs/decisions.md for why. During development, use
# lannaanimalfoundationbwm@gmail.com; production repoints to
# lannacareforanimals@gmail.com.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Root Drive folder ID that the app writes into (Residents/, Projects/, etc.).
# Per-environment — dev/test points at a folder in lannaanimalfoundationbwm@gmail.com;
# production repoints this at the equivalent folder in lannacareforanimals@gmail.com.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Optional: the Drive folder weekly backups go in (and the status tile reads), when it is not Backups/ under the root above.
BACKUP_DRIVE_FOLDER_ID=

# Shelter calendar: vet visits are written to this Google calendar (src/lib/clinics/calendar-sync.ts).
# The token is minted separately from the Drive one, with the calendar.events scope, against the same
# published Desktop client; GOOGLE_CALENDAR_ID is the calendar ("primary" or the long id from its settings).
# Both unset: nothing is sent and nothing is wrong.
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Server Actions encryption key — ONE value per environment, built into both the
# Worker (scripts/deploy.mjs) and the Pi (scripts/pi/write-env.mjs), so a form
# one renders is accepted by the other. Put the same line in this environment's
# values file (.env.local for test, .env.deploy.<env> for uat/production) on the
# dev machine AND on the Pi. Make one: node scripts/actions-key.mjs --generate
# Compare machines: node scripts/actions-key.mjs --env <name>  (fingerprints must match)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Optional. Shared secret the Worker sends to the Pi and the Pi's app checks
# (src/lib/origin-key.ts, docs/pi-hosting.md). Reaches both servers.
ORIGIN_KEY=

# Optional. The visitor count on Settings > System status: a Cloudflare API
# token with Zone > Analytics > Read, and the zone's id. Both or neither; they
# must be on the Pi as well as the Worker (scripts/lib/runtime-config.mjs).
CLOUDFLARE_ANALYTICS_TOKEN=
CLOUDFLARE_ZONE_ID=
