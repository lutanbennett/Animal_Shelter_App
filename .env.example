# Supabase — from your Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only scripts/ read these. The personal access token drives the Management
# API (migrations, deploys); the database password is for scripts/backup.mjs
# (Project Settings > Database — reset it there if it was never written down).
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# The administrator's age PUBLIC key (age1...), for scripts/backup.mjs, which
# refuses to run without it. Public only: the private key (AGE-SECRET-KEY-1...)
# stays in the password manager and must never be put in any env file.
BACKUP_AGE_RECIPIENT=

# Google Drive — OAuth2 against the shelter's Google account (personal Gmail,
# not Workspace, so no domain-wide delegation). See src/lib/google/drive.ts
# and docs/decisions.md for why. During development, use
# lannaanimalfoundationbwm@gmail.com; production repoints to
# lannacareforanimals@gmail.com.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Root Drive folder ID that the app writes into (Residents/, Projects/, etc.).
# Per-environment — dev/test points at a folder in lannaanimalfoundationbwm@gmail.com;
# production repoints this at the equivalent folder in lannacareforanimals@gmail.com.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Optional: the Drive folder weekly backups go in (and the status tile reads), when it is not Backups/ under the root above.
BACKUP_DRIVE_FOLDER_ID=
