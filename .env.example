# Supabase — from your Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive — OAuth2 against the shelter's Google account (personal Gmail,
# not Workspace, so no domain-wide delegation). See src/lib/google/drive.ts
# and docs/decisions.md for why. During development, use
# lannaanimalfoundationbwm@gmail.com; production repoints to
# lannacareforanimals@gmail.com.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Root Drive folder ID that the app writes into (Residents/, Projects/, etc.)
GOOGLE_DRIVE_ROOT_FOLDER_ID=
